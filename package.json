{
  "name": "closet2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:web": "tsc --noEmit && vite build --mode web --base ./ --outDir dist-web",
    "test": "vitest run",
    "build:avatar": "python tools/build_avatar.py",
    "bridge": "node server/ai-bridge.mjs",
    "setup": "python tools/fetch_assets.py && python tools/build_avatar.py && node tools/fetch_models.mjs",
    "verify": "node verify/verify.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}